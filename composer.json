{
    "name": "queuety/queuety",
    "description": "A job queue and durable workflow engine for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "Queuety\\": "src/",
            "Queuety\\CLI\\": "cli/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Queuety\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit"
        ],
        "test:unit": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit --testsuite unit"
        ],
        "test:integration": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit --testsuite integration"
        ],
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
        "cs": "phpcs --warning-severity=0",
        "cs:fix": "phpcbf",
        "verify": ["@analyse", "@cs", "@test"]
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.46",
        "phpunit/phpunit": "^13.1",
        "squizlabs/php_codesniffer": "^3.13.6",
        "wp-coding-standards/wpcs": "^3.4.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
    }
}
